{
	"name": "@corenexis/n8n-nodes-cashly",
	"version": "0.1.1",
	"description": "n8n community node for Cashly, the expense, EMI and debt tracker by Corenexis: transactions, lend and borrow, accounts, EMIs, subscriptions, upcoming bills, insights and webhooks, with instant and polling triggers.",
	"license": "MIT",
	"homepage": "https://github.com/Core-Nexis/n8n-nodes-cashly#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"cashly",
		"corenexis",
		"expense tracker",
		"personal finance",
		"budget",
		"webhooks",
		"emi",
		"debt tracker"
	],
	"author": {
		"name": "Corenexis",
		"email": "support@corenexis.com",
		"url": "https://corenexis.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Core-Nexis/n8n-nodes-cashly.git"
	},
	"bugs": {
		"url": "https://github.com/Core-Nexis/n8n-nodes-cashly/issues",
		"email": "support@corenexis.com"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/CashlyApi.credentials.js",
			"dist/credentials/CashlyOAuth2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/Cashly/Cashly.node.js",
			"dist/nodes/CashlyTrigger/CashlyTrigger.node.js",
			"dist/nodes/CashlyPollingTrigger/CashlyPollingTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
